{
  "Logging": {
	"LogLevel": {
	  "Default": "Information",
	  "Microsoft": "Warning",
	  "Microsoft.Hosting.Lifetime": "Information"
	},
	"Console": {
		"LogLevel": {
			"Default": "None",
			"Microsoft": "None",
			"Microsoft.Hosting.Lifetime": "None"
		},
		"FormatterName": "json",
		"FormatterOptions": {
			"SingleLine": true,
			"IncludeScopes": true,
			"TimestampFormat": "HH:mm:ss ",
			"UseUtcTimestamp": true,
			"JsonWriterOptions": {
				"Indented": true
			}
		}
	},
	"PostgreLog": {
		"LogLevel": {
			"Default": "Debug",
			"PP.Integrator": "Trace"
		},
		"MaxBufferItemsCount": 4096,
		"AutoFlushDuration": 8192,
		"WriteRetryCount": 3
	}
  }
}
